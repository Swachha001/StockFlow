<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stockflow.controller.ActivityLogsController" styleClass="page" spacing="14">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Activity Logs" styleClass="page-title"/>
            <Label text="Audit trail of important actions (latest 500)" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Refresh" styleClass="btn-secondary" onAction="#refresh"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Search by user, action or details" HBox.hgrow="ALWAYS"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label fx:id="countLabel" styleClass="muted"/>
</VBox>
