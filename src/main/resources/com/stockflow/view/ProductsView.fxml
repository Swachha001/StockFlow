<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stockflow.controller.ProductsController" styleClass="page" spacing="14">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Products" styleClass="page-title"/>
            <Label text="Manage inventory items and stock levels" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+ Add Product" styleClass="btn-primary" onAction="#onAdd"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Search by SKU, name or brand" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter" prefWidth="200"/>
        <CheckBox fx:id="lowOnly" text="Low stock only"/>
        <CheckBox fx:id="showInactive" text="Show inactive"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label fx:id="countLabel" styleClass="muted"/>
</VBox>
