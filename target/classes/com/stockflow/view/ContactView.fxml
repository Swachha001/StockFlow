<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="page" spacing="14">
    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label fx:id="titleLabel" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" styleClass="btn-primary" onAction="#onAdd"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Search by name, phone or email" HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="showInactive" text="Show inactive"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label fx:id="countLabel" styleClass="muted"/>
</VBox>
